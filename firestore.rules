rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isParticipant(participants) {
      return isSignedIn() && request.auth.uid in participants;
    }

    // ---------- Users ----------
    // A user can only read/write their own profile document.
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;

      // Favorites are private to the owner.
      match /favorites/{clinicId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ---------- Clinics ----------
    // Any signed-in user can browse clinics.
    // Only the owner (matched by the `uid` field) can create/edit/delete.
    // Exception: any signed-in user may update ONLY the `ratingStats` field
    // (this is what the rating transaction touches).
    match /clinics/{clinicId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;

      allow update: if isSignedIn() && (
                      resource.data.uid == request.auth.uid ||
                      request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['ratingStats'])
                    );

      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Each user owns a single rating doc (doc id == their uid).
      match /ratings/{userId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && request.auth.uid == userId;
        allow delete: if false;
      }
    }

    // ---------- Chat ----------
    // A conversation is readable/writable only by its participants
    // (the patient and the clinic owner).
    match /conversations/{conversationId} {

      // Unread counter for a single participant (defaults to 0 when missing).
      function unreadVal(data, uid) {
        return data.get('unread', {}).get(uid, 0);
      }

      // The other participant in a 1-to-1 conversation.
      function otherParticipant(participants, uid) {
        return participants[0] == uid ? participants[1] : participants[0];
      }

      // A participant may only:
      //  - reset / never inflate THEIR OWN unread counter, and
      //  - bump the OTHER participant's counter by at most 1 (never decrease it).
      function validUnreadChange(oldData, newData, uid) {
        return unreadVal(newData, uid) <= unreadVal(oldData, uid)
          && unreadVal(newData, otherParticipant(oldData.participants, uid))
             >= unreadVal(oldData, otherParticipant(oldData.participants, uid))
          && unreadVal(newData, otherParticipant(oldData.participants, uid))
             <= unreadVal(oldData, otherParticipant(oldData.participants, uid)) + 1;
      }

      allow read: if isParticipant(resource.data.participants);

      // Only the patient can start the conversation, they must include
      // themselves in the participants list, and cannot seed the owner's
      // unread counter with a non-zero value.
      allow create: if isSignedIn()
                    && request.resource.data.patientId == request.auth.uid
                    && request.auth.uid in request.resource.data.participants
                    && unreadVal(request.resource.data,
                                 request.resource.data.ownerId) == 0;

      // Participants may update conversation metadata (lastMessage /
      // lastMessageTime) and the unread counters, but not the participants
      // list, and only within the unread constraints above.
      allow update: if isParticipant(resource.data.participants)
                    && request.resource.data.participants == resource.data.participants
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['lastMessage', 'lastMessageTime', 'unread'])
                    && validUnreadChange(resource.data, request.resource.data,
                                         request.auth.uid);

      allow delete: if false;

      // Messages within a conversation.
      match /messages/{messageId} {
        function conversationParticipants() {
          return get(/databases/$(database)/documents/conversations/$(conversationId))
                   .data.participants;
        }

        allow read: if isParticipant(conversationParticipants());

        // The sender must be the authenticated participant.
        allow create: if isParticipant(conversationParticipants())
                      && request.resource.data.senderId == request.auth.uid;

        // Messages are immutable once sent.
        allow update, delete: if false;
      }
    }
  }
}
